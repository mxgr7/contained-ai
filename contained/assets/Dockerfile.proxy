# contained-proxy — sidecar egress proxy for allowlist mode (PRD 04).
#
# tinyproxy with FilterDefaultDeny; the runtime bind-mounts a generated
# filter file containing one regex per allowed host into
# /etc/tinyproxy/filter at run time. Hostname matching covers both HTTP
# requests and HTTPS CONNECT, which is what we need for SNI-style
# allowlisting without terminating TLS.

FROM debian:bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends tinyproxy ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY tinyproxy.conf /etc/tinyproxy/tinyproxy.conf
COPY tinyproxy-ssh.conf /etc/tinyproxy/tinyproxy-ssh.conf
# Filter files are bind-mounted by the runtime. Ship empty defaults so
# the image is usable standalone (denies everything by default).
RUN : > /etc/tinyproxy/filter \
 && : > /etc/tinyproxy/filter-ssh

# The HTTPS sidecar is the default CMD. The Git-over-SSH sidecar (PRD 09)
# runs the same image with a command override pointing at
# tinyproxy-ssh.conf, so one image serves both roles.
EXPOSE 8888 8889
CMD ["tinyproxy", "-d", "-c", "/etc/tinyproxy/tinyproxy.conf"]
