# contained-base — shared base image for all agents.
#
# Opinionated layout from PRD 02: debian slim, non-root `agent` user,
# recent node and python runtimes, git/curl/ca-certificates, plus the
# agent CLIs themselves installed globally.
#
# Build locally with `contained build`; tagged as the default base ref
# so `contained run` finds it without an explicit `--image`.

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    NODE_MAJOR=20

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates curl git gnupg openssh-client netcat-openbsd unzip \
        build-essential pkg-config \
        python3 python3-pip python3-venv python3-dev pipx \
        ripgrep fd-find jq sqlite3 \
        tini \
 && ln -s /usr/bin/fdfind /usr/local/bin/fd \
 && curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && install -m 0755 -d /etc/apt/keyrings \
 && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        | gpg --dearmor -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
 && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends gh \
 && rm -rf /var/lib/apt/lists/*

# Build the latest stable tmux from source — bookworm's 3.3a lags upstream.
# Resolves the newest non-prerelease tag from the GitHub API at build time;
# pass --no-cache to `docker build` if you want to pick up a newer release.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        libevent-core-2.1-7 libncursesw6 libtinfo6 \
 && apt-get install -y --no-install-recommends \
        libevent-dev libncurses-dev bison \
 && TMUX_VERSION="$(curl -fsSL https://api.github.com/repos/tmux/tmux/releases/latest | jq -r .tag_name)" \
 && curl -fsSL "https://github.com/tmux/tmux/releases/download/${TMUX_VERSION}/tmux-${TMUX_VERSION}.tar.gz" -o /tmp/tmux.tar.gz \
 && mkdir -p /tmp/tmux \
 && tar -xzf /tmp/tmux.tar.gz -C /tmp/tmux --strip-components=1 \
 && cd /tmp/tmux \
 && ./configure \
 && make -j"$(nproc)" \
 && make install \
 && cd / \
 && rm -rf /tmp/tmux /tmp/tmux.tar.gz \
 && apt-get purge -y libevent-dev libncurses-dev bison \
 && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*

# Chromium for agent-browser. Use the distro package instead of Chrome for
# Testing — that channel has no ARM64 Linux build, and apt's chromium pulls in
# all the X11/GTK/NSS runtime libs as deps. agent-browser auto-detects
# /usr/bin/chromium via PATH (find_chrome in cli/src/native/cdp/chrome.rs).
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        chromium \
        fonts-noto-color-emoji fonts-noto-cjk fonts-freefont-ttf \
 && rm -rf /var/lib/apt/lists/*

# hcloud — Hetzner Cloud CLI. Distributed as a static binary via GitHub
# releases; resolves the latest tag at build time. Pass --no-cache to pick up
# a newer release.
RUN HCLOUD_VERSION="$(curl -fsSL https://api.github.com/repos/hetznercloud/cli/releases/latest | jq -r .tag_name)" \
 && HCLOUD_ARCH="$(dpkg --print-architecture)" \
 && curl -fsSL "https://github.com/hetznercloud/cli/releases/download/${HCLOUD_VERSION}/hcloud-linux-${HCLOUD_ARCH}.tar.gz" -o /tmp/hcloud.tar.gz \
 && tar -xzf /tmp/hcloud.tar.gz -C /usr/local/bin hcloud \
 && chmod 0755 /usr/local/bin/hcloud \
 && rm -f /tmp/hcloud.tar.gz

# Go toolchain — official tarball into /usr/local/go. Resolves the latest
# stable release at build time via go.dev/VERSION. Pass --no-cache to pick up
# a newer release.
RUN GO_VERSION="$(curl -fsSL https://go.dev/VERSION?m=text | head -n1)" \
 && GO_ARCH="$(dpkg --print-architecture)" \
 && curl -fsSL "https://go.dev/dl/${GO_VERSION}.linux-${GO_ARCH}.tar.gz" -o /tmp/go.tar.gz \
 && tar -xzf /tmp/go.tar.gz -C /usr/local \
 && rm -f /tmp/go.tar.gz

# Non-root user. uid/gid 1000 matches the `--user` the runtime passes.
RUN groupadd --gid 1000 agent \
 && useradd  --uid 1000 --gid 1000 --create-home --shell /bin/bash agent \
 && mkdir -p /workspace \
 && chown agent:agent /workspace \
 && install -d -m 0700 -o agent -g agent /home/agent/.ssh

# Global npm prefix writable by the agent user so `npm i -g` works post-build.
RUN mkdir -p /home/agent/.npm-global \
 && chown -R agent:agent /home/agent/.npm-global
ENV NPM_CONFIG_PREFIX=/home/agent/.npm-global \
    BUN_INSTALL=/home/agent/.bun \
    CARGO_HOME=/home/agent/.cargo \
    RUSTUP_HOME=/home/agent/.rustup \
    GOPATH=/home/agent/go \
    PATH=/home/agent/.local/bin:/home/agent/.npm-global/bin:/home/agent/.bun/bin:/home/agent/.cargo/bin:/home/agent/go/bin:/usr/local/go/bin:$PATH \
    DISABLE_AUTOUPDATER=1 \
    CLAUDE_CODE_NO_FLICKER=1 \
    AGENT_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium

# Login shells (e.g. tmux panes) re-source /etc/profile, which resets PATH and
# drops the agent-local bin dirs the ENV above sets. Re-add them via profile.d.
RUN printf '%s\n' \
        'export PATH="$HOME/.local/bin:$HOME/.npm-global/bin:$HOME/.bun/bin:$HOME/.cargo/bin:$HOME/go/bin:/usr/local/go/bin:$PATH"' \
        > /etc/profile.d/contained-paths.sh \
 && chmod 0644 /etc/profile.d/contained-paths.sh

USER agent
WORKDIR /workspace

# Claude Code — native installer (npm package is deprecated upstream).
# Installs to ~/.local/bin/claude and ~/.local/share/claude. Then shim the
# launcher so any invocation — docker entrypoint, new tmux pane, sub-shell —
# defaults to --permission-mode bypassPermissions when the caller didn't pass
# one. The container is already sandboxed (no host fs, egress allowlist,
# non-root, cap-drop ALL), so per-call permission gating adds friction without
# meaningful protection. The shim replaces the installer's launcher in-place
# so it wins regardless of PATH order (the installer prepends ~/.local/bin to
# .bashrc, which would otherwise shadow any /usr/local/* shim).
RUN curl -fsSL https://claude.ai/install.sh | bash \
 && mv /home/agent/.local/bin/claude /home/agent/.local/bin/claude-real \
 && printf '%s\n' \
        '#!/bin/bash' \
        'real=/home/agent/.local/bin/claude-real' \
        'for arg in "$@"; do' \
        '    case "$arg" in' \
        '        --permission-mode|--permission-mode=*)' \
        '            exec "$real" "$@"' \
        '            ;;' \
        '    esac' \
        'done' \
        'exec "$real" --permission-mode bypassPermissions "$@"' \
        > /home/agent/.local/bin/claude \
 && chmod 0755 /home/agent/.local/bin/claude

# pi coding-agent — Mario Zechner's terminal coding harness.
# Upstream: https://github.com/badlogic/pi-mono/tree/main/packages/coding-agent
RUN npm install -g @mariozechner/pi-coding-agent

# wrangler — Cloudflare Workers CLI.
RUN npm install -g wrangler

# uv — fast Python package/venv manager from Astral. Installs to ~/.local/bin.
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# bun — JavaScript runtime and package manager. Installs to ~/.bun/bin.
RUN curl -fsSL https://bun.sh/install | bash

# Rust — stable toolchain via rustup. Installs to ~/.cargo and ~/.rustup.
RUN curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain stable

# Default git identity so commits work without a host gitconfig mount.
# Override at runtime by mounting ~/.gitconfig or passing GIT_AUTHOR_* env vars.
RUN git config --global user.name  "Contained Agent" \
 && git config --global user.email "agent@contained.local" \
 && git config --global init.defaultBranch main

# agent-browser — Vercel Labs CDP browser automation daemon.
# Skip `agent-browser install` (Chrome for Testing has no ARM64 build); the
# package picks up system chromium via AGENT_BROWSER_EXECUTABLE_PATH above.
RUN npm install -g agent-browser

CMD ["bash"]
